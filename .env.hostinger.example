APP_NAME="Universal Business Systems Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Hostinger MySQL (hPanel → Databases)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# Use "database" only after `php artisan migrate` has created the cache table

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="your@email.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

BH_CAMPUS_NAME="Main Campus"
BH_CAMPUS_LAT=-17.7833
BH_CAMPUS_LNG=31.0333
GOOGLE_MAPS_API_KEY=
BH_HOLDING_FEE_AMOUNT=50
BH_HOLDING_FEE_CURRENCY=usd
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Deployment panel (super-admin → /admin/deployment)
DEPLOY_ENABLED=true
DEPLOY_GIT_ENABLED=true
DEPLOY_GIT_BRANCH=main
DEPLOY_GIT_REMOTE=origin
